# Copy to `.env` and fill in values. Never commit real secrets.

# Base URL of the GraphQL backend, or its full /api/graphql endpoint
# (no trailing slash).
NEXT_PUBLIC_GRAPHQL_SERVER_HOST=

# CloudFront distribution origin used to prefix relative résumé image paths
# served by the GraphQL API, e.g. `https://dxxxx.cloudfront.net`.
NEXT_PUBLIC_AWS_CLOUDFRONT_URL=

# Full Goodreads list RSS URL (HTTPS, host `goodreads.com`), including its
# access key (server-only). Treat the key as a secret: keep it out of source
# control, rotate it if it was ever exposed, and use a fresh key after rotation.
GOODREADS_FEED_URL=
